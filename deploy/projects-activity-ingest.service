[Unit]
Description=Projects activity log -> the tenant's MaluDB (one batch)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/apps/projects/mcp
ExecStart=/srv/apps/projects/mcp/venv/bin/python /srv/apps/projects/mcp/activity_ingest.py
