[Unit]
Description=Projects activity MCP server (FastMCP, loopback :{{MCP_ACTIVITY_PORT}})
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/apps/projects/mcp
ExecStart=/srv/apps/projects/mcp/venv/bin/python /srv/apps/projects/mcp/activity_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
